# Copy to .env to change development. Nothing here is required: every value has a default in
# compose.yaml or compose.override.yaml. .env is gitignored — keys stay on your machine.

# ── The model ──────────────────────────────────────────────────────────────
# The model runs in the browser, on WebGPU, and the browser downloads it once (a few GB) the first
# time Ask or the assistant opens. Where its shards are served: <url>/<model>/, the MLC weights
# directory, and <url>/<model>.wasm, its compiled library (the model is named in web/src/lib/ai.ts).
# A path is the web's own origin. Unset: WebLLM's prebuilt, from Hugging Face and GitHub.
# KEASY_MODEL_URL=https://models.example.com

# ── The platform ───────────────────────────────────────────────────────────
# The kanzo-ui release the identity service comes from (compose.override.yaml).
# KANZO_UI_REF=v0.44.0
