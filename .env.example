# Copy to .env to change development. Nothing here is required: every value has a default in
# compose.yaml or compose.override.yaml. .env is gitignored — keys stay on your machine.

# ── AI ─────────────────────────────────────────────────────────────────────
# Which model answers each alias, provider/model. Unset: local models through Docker Model Runner,
# which `make dev` pulls (~6.5 GB once). With both on a provider, nothing is pulled.
#   anthropic/<model>  openai/<model>  gemini/<model>  mistral/<model>  openrouter/<vendor>/<model>
#   local/<model>      (Docker Model Runner, e.g. local/hf.co/NousResearch/Hermes-3-Llama-3.2-3B-GGUF:Q4_K_M)
# AI_CHAT=anthropic/claude-sonnet-5-5
# AI_COMPLETE=anthropic/claude-haiku-4-5

# The provider's key, under its usual name.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=

# ── The platform ───────────────────────────────────────────────────────────
# The kanzo-ui release the identity service and the AI gateway come from (compose.override.yaml).
# KANZO_UI_REF=v0.35.0
