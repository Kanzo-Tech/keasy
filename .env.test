# Keasy test profile
# Values for the MinIO connectivity test (`make test-minio`), which runs
# `cloud::reader::tests` against the managed MinIO started by `make dev-minio`.
# Local, throwaway dev credentials only — never put real cloud credentials here.

# ─── MinIO connectivity test ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=keasytest
AWS_SECRET_ACCESS_KEY=KeasyTest2026Local
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://minio.localtest.me:9000
KEASY_MINIO_TEST_URL=s3://connector-test/
