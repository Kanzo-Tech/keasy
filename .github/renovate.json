{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "One rmlext release publishes every @fossil-lang/* package at the same version; bump them in one PR so keasy never lands a mismatched set.",
      "groupName": "fossil release",
      "matchPackageNames": [
        "/^@fossil-lang//"
      ],
      "schedule": [
        "at any time"
      ]
    }
  ],
  "customManagers": [
    {
      "description": "Image pins that are Terraform variable defaults, which no built-in manager reads.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^infra/terraform/.+\\.tf$/"
      ],
      "matchStrings": [
        "variable\\s+\"\\w+_image\"\\s*\\{[^}]*?default\\s*=\\s*\"(?<depName>[^\":]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
