{
  "name": "@keasy/api",
  "version": "0.1.0",
  "private": true,
  "description": "The keasy HTTP contract, TypeScript side: the spec the server publishes, its types and a client over them",
  "type": "module",
  "exports": {
    ".": "./src/client.ts",
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts --read-write-markers --default-non-nullable=false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5"
  }
}
