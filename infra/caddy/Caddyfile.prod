# Production Caddyfile — app routing
#
# Requires env vars:
#   KEASY_BASE_DOMAIN    — e.g. "keasy.example.com"
#   CLOUDFLARE_API_TOKEN — for TLS via DNS-01

# Main domain — full app routing
{$KEASY_BASE_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	# `/v1` is NOT routed here. The web is a Backend For Frontend: the browser
	# calls `/v1` on the web, which attaches the bearer token and forwards it to
	# the server over the internal network. Routing it around the web would be
	# routing around the only process that holds a credential.
	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
