{
  "credentials": [
    {
      "name": "MinIO dev",
      "spec": {
        "storage": {
          "kind": "s3",
          "access_key_id": "minioadmin",
          "secret_access_key": "minioadmin",
          "region": "us-east-1",
          "endpoint": "http://minio.localhost:9000"
        }
      }
    }
  ],
  "connections": [
    {
      "name": "MinIO dev bucket",
      "credential": "MinIO dev",
      "target": { "storage": { "url": "s3://keasy-dev/", "kind": "data", "direction": "source" } }
    },
    {
      "name": "MinIO dev shapes",
      "credential": "MinIO dev",
      "target": { "storage": { "url": "s3://keasy-dev/vocab/", "kind": "vocab", "direction": "source" } }
    },
    {
      "name": "Workspace output",
      "credential": "MinIO dev",
      "target": { "storage": { "url": "s3://keasy-dev/output/", "kind": "data", "direction": "sink" } }
    }
  ]
}
