{
  "secrets": [
    {
      "name": "Dev S3",
      "spec": {
        "kind": "s3",
        "access_key_id": "keasy-admin",
        "secret_access_key": "keasy-admin-secret",
        "region": "us-east-1",
        "endpoint": "http://s3.localhost:9000"
      }
    }
  ],
  "connections": [
    {
      "name": "LDBC SNB",
      "secret": "Dev S3",
      "target": { "url": "s3://keasy-dev/ldbc/", "kind": "data", "direction": "source" }
    },
    {
      "name": "OpenFlights",
      "secret": "Dev S3",
      "target": { "url": "s3://keasy-dev/geo/", "kind": "data", "direction": "source" }
    },
    {
      "name": "Dev shapes",
      "secret": "Dev S3",
      "target": { "url": "s3://keasy-dev/vocab/", "kind": "vocab", "direction": "source" }
    },
    {
      "name": "Workspace output",
      "secret": "Dev S3",
      "target": { "url": "s3://keasy-dev/output/", "kind": "data", "direction": "sink" }
    }
  ]
}
