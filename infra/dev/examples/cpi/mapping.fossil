CPIProjects : CPIProject from CPIProjectRow
    @subject = "{CPIProjectRow.iri}"
    label      = CPIProjectRow.label
    acronym    = CPIProjectRow.acronym
    identifier = CPIProjectRow.identifier
    summary    = CPIProjectRow.summary
    title      = CPIProjectRow.title

Phases : Phase from PhaseRow
    @subject = "{PhaseRow.iri}"
    label                = PhaseRow.label
    kind                 = PhaseRow.kind
    admittedOfferCount   = PhaseRow.admittedOfferCount
    awardDate            = parse.date(PhaseRow.awardDate, "%Y-%m-%d")
    excludedOfferCount   = PhaseRow.excludedOfferCount
    formalizationDate    = parse.date(PhaseRow.formalizationDate, "%Y-%m-%d")
    identifier           = PhaseRow.identifier
    lotDivisionRationale = PhaseRow.lotDivisionRationale
    publicationDate      = parse.date(PhaseRow.publicationDate, "%Y-%m-%d")
    receivedOfferCount   = PhaseRow.receivedOfferCount
    summary              = PhaseRow.summary
    title                = PhaseRow.title

Organizations : Organization from OrganizationRow
    @subject = "{OrganizationRow.iri}"
    label    = OrganizationRow.label
    altLabel = OrganizationRow.altLabel
    kind     = OrganizationRow.kind
    title    = OrganizationRow.title

ProcedureParticipations : ProcedureParticipation from ProcedureParticipationRow
    @subject = "{ProcedureParticipationRow.iri}"
    awardedAmount      = ProcedureParticipationRow.awardedAmount
    currency           = ProcedureParticipationRow.currency
    offeredAmount      = ProcedureParticipationRow.offeredAmount
    participationScore = ProcedureParticipationRow.participationScore
    rankingPosition    = ProcedureParticipationRow.rankingPosition

AwardCriterions : AwardCriterion from AwardCriterionRow
    @subject = "{AwardCriterionRow.iri}"
    label            = AwardCriterionRow.label
    criterionFormula = AwardCriterionRow.criterionFormula
    description      = AwardCriterionRow.description
    minimumThreshold = AwardCriterionRow.minimumThreshold
    weight           = AwardCriterionRow.weight

SolutionSpecifications : SolutionSpecification from SolutionSpecificationRow
    @subject = "{SolutionSpecificationRow.iri}"
    label       = SolutionSpecificationRow.label
    description = SolutionSpecificationRow.description
    title       = SolutionSpecificationRow.title

TenderRequirements : TenderRequirement from TenderRequirementRow
    @subject = "{TenderRequirementRow.iri}"
    label       = TenderRequirementRow.label
    description = TenderRequirementRow.description

ThematicAreas : ThematicArea from ThematicAreaRow
    @subject = "{ThematicAreaRow.iri}"
    label     = ThematicAreaRow.label
    prefLabel = ThematicAreaRow.prefLabel

Antecedents : Antecedent from AntecedentRow
    @subject = "{AntecedentRow.iri}"
    label       = AntecedentRow.label
    description = AntecedentRow.description

AwardAllocations : AwardAllocation from AwardAllocationRow
    @subject = "{AwardAllocationRow.iri}"
    allocatedAmount = AwardAllocationRow.allocatedAmount
    currency        = AwardAllocationRow.currency

AwardOutcomes : AwardOutcome from AwardOutcomeRow
    @subject = "{AwardOutcomeRow.iri}"
    admittedOfferCount = AwardOutcomeRow.admittedOfferCount
    decisionDate       = parse.date(AwardOutcomeRow.decisionDate, "%Y-%m-%d")
    excludedOfferCount = AwardOutcomeRow.excludedOfferCount
    receivedOfferCount = AwardOutcomeRow.receivedOfferCount

CPIKnowledgeBases : CPIKnowledgeBase from CPIKnowledgeBaseRow
    @subject = "{CPIKnowledgeBaseRow.iri}"
    label       = CPIKnowledgeBaseRow.label
    description = CPIKnowledgeBaseRow.description
    title       = CPIKnowledgeBaseRow.title

Challenges : Challenge from ChallengeRow
    @subject = "{ChallengeRow.iri}"
    label       = ChallengeRow.label
    description = ChallengeRow.description

Concepts : Concept from ConceptRow
    @subject = "{ConceptRow.iri}"
    label     = ConceptRow.label
    prefLabel = ConceptRow.prefLabel

ConceptSchemes : ConceptScheme from ConceptSchemeRow
    @subject = "{ConceptSchemeRow.iri}"
    label     = ConceptSchemeRow.label
    prefLabel = ConceptSchemeRow.prefLabel

ContractTerms : ContractTerm from ContractTermRow
    @subject = "{ContractTermRow.iri}"
    label       = ContractTermRow.label
    amount      = ContractTermRow.amount
    currency    = ContractTermRow.currency
    description = ContractTermRow.description

Deadlines : Deadline from DeadlineRow
    @subject = "{DeadlineRow.iri}"
    label        = DeadlineRow.label
    deadlineDate = parse.date(DeadlineRow.deadlineDate, "%Y-%m-%d")
    description  = DeadlineRow.description

Deliverables : Deliverable from DeliverableRow
    @subject = "{DeliverableRow.iri}"
    label          = DeliverableRow.label
    description    = DeliverableRow.description
    sequenceNumber = DeliverableRow.sequenceNumber
    title          = DeliverableRow.title

Documents : Document from DocumentRow
    @subject = "{DocumentRow.iri}"
    label      = DocumentRow.label
    identifier = DocumentRow.identifier
    sourcePath = DocumentRow.sourcePath
    title      = DocumentRow.title

ExpectedApproachs : ExpectedApproach from ExpectedApproachRow
    @subject = "{ExpectedApproachRow.iri}"
    label       = ExpectedApproachRow.label
    description = ExpectedApproachRow.description

IPArrangements : IPArrangement from IPArrangementRow
    @subject = "{IPArrangementRow.iri}"
    label       = IPArrangementRow.label
    description = IPArrangementRow.description

IPClauses : IPClause from IPClauseRow
    @subject = "{IPClauseRow.iri}"
    label       = IPClauseRow.label
    description = IPClauseRow.description

IPLicenseArrangements : IPLicenseArrangement from IPLicenseArrangementRow
    @subject = "{IPLicenseArrangementRow.iri}"
    label       = IPLicenseArrangementRow.label
    description = IPLicenseArrangementRow.description
    exclusive   = IPLicenseArrangementRow.exclusive

IPOwnershipAllocations : IPOwnershipAllocation from IPOwnershipAllocationRow
    @subject = "{IPOwnershipAllocationRow.iri}"
    label       = IPOwnershipAllocationRow.label
    description = IPOwnershipAllocationRow.description

IPRights : IPRight from IPRightRow
    @subject = "{IPRightRow.iri}"
    label       = IPRightRow.label
    description = IPRightRow.description
    exclusive   = IPRightRow.exclusive

Insights : Insight from InsightRow
    @subject = "{InsightRow.iri}"
    label       = InsightRow.label
    description = InsightRow.description

MarketEngagements : MarketEngagement from MarketEngagementRow
    @subject = "{MarketEngagementRow.iri}"
    marketEngagementSummary = MarketEngagementRow.marketEngagementSummary
    participantCount        = MarketEngagementRow.participantCount
    proposalCount           = MarketEngagementRow.proposalCount

MarketParticipations : MarketParticipation from MarketParticipationRow
    @subject = "{MarketParticipationRow.iri}"
    label       = MarketParticipationRow.label
    description = MarketParticipationRow.description

MarketQuestions : MarketQuestion from MarketQuestionRow
    @subject = "{MarketQuestionRow.iri}"
    label        = MarketQuestionRow.label
    questionText = MarketQuestionRow.questionText

Milestones : Milestone from MilestoneRow
    @subject = "{MilestoneRow.iri}"
    label          = MilestoneRow.label
    description    = MilestoneRow.description
    dueDate        = parse.date(MilestoneRow.dueDate, "%Y-%m-%d")
    sequenceNumber = MilestoneRow.sequenceNumber
    title          = MilestoneRow.title

Needs : Need from NeedRow
    @subject = "{NeedRow.iri}"
    label       = NeedRow.label
    description = NeedRow.description

Objectives : Objective from ObjectiveRow
    @subject = "{ObjectiveRow.iri}"
    label       = ObjectiveRow.label
    description = ObjectiveRow.description

Observations : Observation from ObservationRow
    @subject = "{ObservationRow.iri}"
    label       = ObservationRow.label
    description = ObservationRow.description

PlannedExecutionStages : PlannedExecutionStage from PlannedExecutionStageRow
    @subject = "{PlannedExecutionStageRow.iri}"
    label          = PlannedExecutionStageRow.label
    description    = PlannedExecutionStageRow.description
    dueDate        = parse.date(PlannedExecutionStageRow.dueDate, "%Y-%m-%d")
    sequenceNumber = PlannedExecutionStageRow.sequenceNumber
    title          = PlannedExecutionStageRow.title

Problems : Problem from ProblemRow
    @subject = "{ProblemRow.iri}"
    label       = ProblemRow.label
    description = ProblemRow.description

RoyaltyArrangements : RoyaltyArrangement from RoyaltyArrangementRow
    @subject = "{RoyaltyArrangementRow.iri}"
    label             = RoyaltyArrangementRow.label
    description       = RoyaltyArrangementRow.description
    royaltyPercentage = RoyaltyArrangementRow.royaltyPercentage

SubmissionChannels : SubmissionChannel from SubmissionChannelRow
    @subject = "{SubmissionChannelRow.iri}"
    label       = SubmissionChannelRow.label
    description = SubmissionChannelRow.description
    email       = SubmissionChannelRow.email
    url         = SubmissionChannelRow.url

TenderLots : TenderLot from TenderLotRow
    @subject = "{TenderLotRow.iri}"
    label       = TenderLotRow.label
    description = TenderLotRow.description
    lotNumber   = TenderLotRow.lotNumber
    title       = TenderLotRow.title

TenderScopes : TenderScope from TenderScopeRow
    @subject = "{TenderScopeRow.iri}"
    label           = TenderScopeRow.label
    contractObject  = TenderScopeRow.contractObject
    functionalScope = TenderScopeRow.functionalScope
    technicalScope  = TenderScopeRow.technicalScope

TerritorialScopes : TerritorialScope from TerritorialScopeRow
    @subject = "{TerritorialScopeRow.iri}"
    label     = TerritorialScopeRow.label
    prefLabel = TerritorialScopeRow.prefLabel

CPIProject_hasPhase : CPIProject from CPIProject_hasPhaseRow
    @subject = "{CPIProject_hasPhaseRow.iri}"
    hasPhase = Phase(CPIProject_hasPhaseRow.o)

