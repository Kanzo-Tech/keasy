# The storage service in development (kanzo-ui services/storage): the dev store, SeaweedFS, declared
# as the organization's one storage location, reached through its own STS; its admin user stands in
# for the deployment's identity, which production has and development does not.
STORAGE_LOCATIONS=[{"kind":"s3","url":"s3://keasy-dev/","region":"us-east-1","roleArn":"arn:aws:iam::000000000000:role/keasy-vended","stsEndpoint":"http://s3:9000","s3Endpoint":"http://s3.localhost:9000"}]
STORAGE_DEV_ACCESS_KEY=keasy-admin
STORAGE_DEV_SECRET_KEY=keasy-admin-secret
AUTH_ISSUER=http://localhost:8080/realms/kanzo
AUTH_CLIENT_ID=keasy
AUTH_ORGANIZATION=acme
