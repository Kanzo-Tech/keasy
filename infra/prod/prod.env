# The deployment's values — everything but its secrets, which are in secrets.sops.env. Versioned:
# each change is a commit. Edit, then `make deploy` on the server.

# The release every organization runs: ghcr.io/kanzo-tech/keasy-{server,web}:<KEASY_VERSION>.
KEASY_VERSION=0.0.5

# Each organization at <alias>.<KEASY_DOMAIN>, Keycloak at auth.<KEASY_DOMAIN>.
KEASY_DOMAIN=keasy.example.com
KEASY_ORIGIN=https://{organization}.${KEASY_DOMAIN}
KC_HOSTNAME=https://auth.${KEASY_DOMAIN}
KEASY_ORGANIZATIONS=./infra/prod/orgs

# The Let's Encrypt account the certificates are issued to.
ACME_EMAIL=ops@example.com

# Where the model's shards are served — <url>/<model>/ and <url>/<model>.wasm — for the browser to
# download once. Unset: WebLLM's prebuilt, from Hugging Face and GitHub.
# KEASY_MODEL_URL=https://models.keasy.example.com
