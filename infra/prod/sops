#!/bin/sh
# sops — from the PATH, or else its Docker image, so a deployment needs Docker and nothing else.
# The age key is SOPS_AGE_KEY_FILE (the Makefile's: ~/.config/sops/age/keys.txt).
command -v sops >/dev/null 2>&1 && exec sops "$@"
key=${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}
exec docker run --rm -i -v "$PWD:$PWD" -w "$PWD" -v "$key:/age/keys.txt:ro" -e SOPS_AGE_KEY_FILE=/age/keys.txt \
  ghcr.io/getsops/sops:v3.10.2 "$@"
