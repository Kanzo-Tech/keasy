# Copy to terraform.tfvars (gitignored) on the manager. Every key here is an
# organization alias of the `kanzo` realm (kanzo-ui services/auth/realm tfvars).
# The OIDC secret is not written here: `make deploy-instances` passes it from the
# infra/auth output.

base_domain     = "keasy.example.com"
oidc_issuer_url = "https://auth.keasy.example.com/realms/kanzo"

release_version = "0.0.3"

# The fleet. Adding a tenant = its organization in the realm, an entry here.
tenants = {
  acme = {
    display_name = "Acme"
    # Optional: the workspace's look — the theme generator's YAML, as exported
    # (see infra/dev/branding.example.yml).
    # branding_file = "branding/acme.yml"
  }
}
