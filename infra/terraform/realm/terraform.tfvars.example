# Copy to terraform.tfvars (gitignored). This carries identity/membership only —
# emails are PII, so this file stays operator-local, never committed. Tenant TOPOLOGY
# (which workspaces exist, display name, image refs) lives in git under
# infra/k8s/tenants/*.yaml (the Argo ApplicationSet source).

# Public Keycloak host — the keycloak provider connects through the ingress (the
# operator runs apply from a machine with kubeconfig + DNS, not from inside the cluster).
kc_url            = "https://auth.keasy.example.com"
kc_admin_username = "admin"
kc_admin_password = "from-platform-admin-secret"
kc_hostname       = "auth.keasy.example.com"
base_domain       = "keasy.example.com"

# Optional: kubeconfig for writing the per-tenant Secrets (defaults to ~/.kube/config).
# kubeconfig_path    = "~/.kube/config"
# kubeconfig_context = "keasy-prod"


# SSO IdP — users log in here; Keycloak links to the declared user by email.
# Google example shown; swap endpoints for any OIDC IdP.
idp = {
  alias             = "google"
  display_name      = "Google"
  client_id         = "xxxx.apps.googleusercontent.com"
  client_secret     = "xxxx"
  authorization_url = "https://accounts.google.com/o/oauth2/v2/auth"
  token_url         = "https://oauth2.googleapis.com/token"
  user_info_url     = "https://openidconnect.googleapis.com/v1/userinfo"
  issuer            = "https://accounts.google.com"
}

# The fleet. Adding a tenant = an entry here + `terraform apply`.
tenants = {
  acme = {
    display_name = "Acme"
    owners       = ["angel.iglesias@kanzo.tech"]
    members      = []
  }
}
