# syntax=docker/dockerfile:1
# Dev image for keasy-server (hot reload). Build context: `server/`.

FROM rust:1.90-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    clang libclang-dev curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Same CA plumbing as the release image — see server/Dockerfile.
RUN mkdir -p /etc/pki/tls/certs \
    && ln -sf /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

RUN cargo install cargo-watch

# Manifests only: `src/` is bind-mounted, and deps compile once at runtime into
# the persistent `server-target` + `cargo-registry` volumes (docker-compose.dev.yml).
WORKDIR /src/server
COPY Cargo.toml Cargo.lock ./

EXPOSE 8080
CMD ["cargo", "watch", "-x", "run"]
