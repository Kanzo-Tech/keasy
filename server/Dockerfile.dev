# syntax=docker/dockerfile:1
# Dev image for keasy-server (hot reload). Build context: `server/`.

FROM rust:1-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src/server
COPY rust-toolchain.toml ./
RUN rustup toolchain install && cargo install cargo-watch

# Manifests only: `src/` and `crates/` are bind-mounted, and deps compile once at runtime into
# the persistent `server-target` + `cargo-registry` volumes (docker-compose.yml).
COPY Cargo.toml Cargo.lock ./

EXPOSE 8080
CMD ["cargo", "watch", "-x", "run"]
